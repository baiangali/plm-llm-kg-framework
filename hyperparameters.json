{
  "plm": {
    "model_name": "xlm-roberta-base",
    "max_sequence_length": 512,
    "embedding_size": 768
  },
  "training": {
    "batch_size": 16,
    "learning_rate": 2e-5,
    "optimizer": "AdamW",
    "epochs": 5,
    "warmup_steps": 500,
    "weight_decay": 0.01
  },
  "inference": {
    "top_k_candidates": 10,
    "max_relations_per_concept": 5
  },
  "llm": {
    "model": "gpt-4-turbo",
    "temperature": 0,
    "max_tokens": 300,
    "prompting_type": "instruction_based"
  }
}
